VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=false
VITE_SITE_URL=http://localhost:5173
VITE_DEPLOYMENT_TARGET=local
# Allowed targets: local (development only), docker (local production build), render.
# Render production rejects localhost VITE_API_URL and VITE_SITE_URL values.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Hai biến Cloudinary là tùy chọn nhưng phải được điền cùng nhau để tải ảnh từ máy.
# Upload preset phải là unsigned. Nếu để trống, trang quản trị chỉ nhận URL ảnh HTTPS.
VITE_GA_MEASUREMENT_ID=
